{
  "name": "deploy-action",
  "version": "0.0.0",
  "private": true,
  "description": "MACH Composer deploy action",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "package": "rolldown -c rolldown.config.mjs",
    "test": "jest",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mach-composer/deploy-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/tool-cache": "^2.0.2",
    "@types/semver": "^7.8.0",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-plugin-github": "^4.6.0",
    "eslint-plugin-jest": "^27.9.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.3.2",
    "prettier": "2.8.0",
    "rolldown": "1.2.16",
    "ts-jest": "^29.4.15",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@actions/http-client": "^3.0.2"
  }
}
